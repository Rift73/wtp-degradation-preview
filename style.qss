/* ═══════════════════════════════════════════════════════════════════
   WTP Degradation Preview - dark theme
   Tokens (Qt stylesheets have no variables, so the hex values repeat):
     bg #0F1115      panel #161A20     card #1C2129     card-hover #222833
     border #2A3039  text #E6E8EB      muted #8B93A1    accent #5B9DF5
     danger #E05555  warn #D4A843      ok #4CAF6A       radius 6
   Dynamic properties the code sets (re-polish the widget after changing):
     #stepCard[state]          "ok" | "error" | "disabled"
     #statusDot[level]         "idle" | "ok" | "error"
     #videoBackendChip[state]  "ffmpeg" | "pyav" | "none"
   ═══════════════════════════════════════════════════════════════════ */

/* ── Base ── */
QMainWindow, QDialog {
    background-color: #0F1115;
    color: #E6E8EB;
}

QWidget {
    background-color: transparent;
    color: #E6E8EB;
}

QToolTip {
    background-color: #222833;
    border: 1px solid #3A4250;
    border-radius: 4px;
    padding: 4px 8px;
    color: #E6E8EB;
}

/* ── Layout panels ── */
#headerBar {
    background-color: #161A20;
    border: none;
    border-bottom: 1px solid #2A3039;
}

#appTitle {
    color: #E6E8EB;
    font-size: 11pt;
    font-weight: 600;
}

#imageName, #dimLabel {
    color: #8B93A1;
}

/* Status-bar error button (visible only after a failed run) */
QToolButton#errorButton {
    background-color: #2E1A1A;
    border: 1px solid #5A2A2A;
    border-radius: 4px;
    color: #E05555;
    padding: 1px 8px;
}

QToolButton#errorButton:hover {
    background-color: #3A2020;
    border-color: #E05555;
}

#pipelinePanel {
    background-color: #161A20;
    border: none;
    border-right: 1px solid #2A3039;
}

#previewPanel {
    background-color: #0F1115;
}

#panelToolbar,
#previewToolbar {
    background-color: #161A20;
    border: none;
    border-bottom: 1px solid #2A3039;
}

#emptyHint {
    color: #8B93A1;
    padding: 24px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QSplitter::handle:horizontal {
    background-color: #0F1115;
    width: 5px;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background-color: #5B9DF5;
}

QStatusBar {
    background-color: #161A20;
    border-top: 1px solid #2A3039;
    color: #8B93A1;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── Step card ── */
#stepCard {
    background-color: #1C2129;
    border: 1px solid #2A3039;
    border-radius: 6px;
}

#stepCard:hover {
    background-color: #222833;
}

#stepCard[state="ok"] {
    border-color: #2B3F33;
}

#stepCard[state="error"] {
    border: 1px solid #E05555;
}

#stepCard[state="disabled"] {
    background-color: #14181E;
    border-color: #22272F;
}

#stepCard[state="disabled"] #cardTitle,
#stepCard[state="disabled"] #cardSummary,
#stepCard[state="disabled"] #paramLabel {
    color: #5A6270;
}

#cardHeader,
#cardActions {
    background: transparent;
    border: none;
}

#dragHandle {
    color: #5A6270;
    padding: 0 2px;
}

#dragHandle:hover {
    color: #E6E8EB;
}

#cardTitle {
    background: transparent;
    border: none;
    min-height: 0;
    padding: 2px 4px;
    color: #E6E8EB;
    font-weight: 600;
    text-align: left;
}

#cardTitle:hover {
    color: #FFFFFF;
}

#cardSummary {
    color: #8B93A1;
    font-size: 9pt;
}

#paramLabel {
    color: #8B93A1;
    font-size: 9pt;
}

#statusDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #3A4250;
}

/* level "idle" (or unset) uses the base grey above */
#statusDot[level="ok"]    { background-color: #4CAF6A; }
#statusDot[level="error"] { background-color: #E05555; }

/* ── Buttons ── */
QPushButton {
    background-color: #1C2129;
    border: 1px solid #2A3039;
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 20px;
    color: #E6E8EB;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #222833;
    border-color: #3A4250;
}

QPushButton:pressed {
    background-color: #2A3039;
    border-color: #5B9DF5;
}

QPushButton:disabled {
    background-color: #161A20;
    border-color: #22272F;
    color: #5A6270;
}

/* Primary action: Add step, Open image */
#addStepBtn,
QPushButton#accentButton {
    background-color: #5B9DF5;
    border: 1px solid #5B9DF5;
    color: #FFFFFF;
}

#addStepBtn:hover,
QPushButton#accentButton:hover {
    background-color: #7AB3FF;
    border-color: #7AB3FF;
}

#addStepBtn:pressed,
QPushButton#accentButton:pressed {
    background-color: #4A88D9;
    border-color: #4A88D9;
}

/* Video backend chip in the header (menu: locate ffmpeg, pick the backend);
   styled like #toolBtn, amber while no backend is available */
QToolButton#videoBackendChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
    color: #E6E8EB;
    font-weight: 400;
}

QToolButton#videoBackendChip:hover {
    background-color: #222833;
    border-color: #2A3039;
}

QToolButton#videoBackendChip:pressed {
    background-color: #2A3039;
}

QToolButton#videoBackendChip::menu-indicator {
    image: none;
    width: 0;
}

QToolButton#videoBackendChip[state="none"] {
    background-color: #2A2413;
    border-color: #6B5A24;
    color: #D4A843;
}

QToolButton#videoBackendChip[state="none"]:hover {
    background-color: #382F18;
    border-color: #D4A843;
}

/* Compact icon buttons on the card header */
#iconBtn,
#deleteBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-height: 0;
    padding: 2px 4px;
    color: #8B93A1;
    font-weight: 400;
}

#iconBtn:hover {
    background-color: #2A3039;
    color: #E6E8EB;
}

#iconBtn:pressed {
    background-color: #343C48;
}

#deleteBtn:hover {
    background-color: #3A2226;
    color: #E05555;
}

#deleteBtn:pressed {
    background-color: #4A2A2E;
    color: #E05555;
}

/* Flat toggle buttons on the preview toolbar */
#toolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
    color: #E6E8EB;
    font-weight: 400;
}

#toolBtn:hover {
    background-color: #222833;
    border-color: #2A3039;
}

#toolBtn:pressed {
    background-color: #2A3039;
}

#toolBtn:checked {
    background-color: #5B9DF5;
    border-color: #5B9DF5;
    color: #FFFFFF;
}

#toolBtn:checked:hover {
    background-color: #7AB3FF;
    border-color: #7AB3FF;
}

#toolBtn:disabled {
    background: transparent;
    border-color: transparent;
    color: #5A6270;
}

#zoomReadout {
    color: #8B93A1;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9pt;
    min-width: 44px;
}

/* ── Text and number inputs ── */
QLineEdit {
    background-color: #0F1115;
    border: 1px solid #2A3039;
    border-radius: 4px;
    padding: 4px 8px;
    color: #E6E8EB;
    selection-background-color: #274467;
    placeholder-text-color: #5A6270;
}

QLineEdit:hover {
    border-color: #3A4250;
}

QLineEdit:focus {
    border-color: #5B9DF5;
}

QSpinBox, QDoubleSpinBox {
    background-color: #0F1115;
    border: 1px solid #2A3039;
    border-radius: 4px;
    padding: 2px 6px;
    color: #E6E8EB;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9pt;
    selection-background-color: #274467;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #3A4250;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5B9DF5;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 0px;
    border: none;
}

#seedSpin {
    min-width: 80px;
}

/* ── Combo box ── */
QComboBox {
    background-color: #0F1115;
    border: 1px solid #2A3039;
    border-radius: 4px;
    padding: 4px 8px;
    padding-right: 24px;
    min-height: 18px;
    color: #E6E8EB;
}

QComboBox:hover {
    border-color: #3A4250;
}

QComboBox:focus, QComboBox:on {
    border-color: #5B9DF5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8B93A1;
}

QComboBox::down-arrow:hover {
    border-top-color: #E6E8EB;
}

QComboBox QAbstractItemView {
    background-color: #1C2129;
    border: 1px solid #2A3039;
    selection-background-color: #274467;
    selection-color: #E6E8EB;
    outline: none;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #222833;
}

/* ── Check box ── */
QCheckBox {
    spacing: 6px;
    color: #E6E8EB;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

QCheckBox::indicator:unchecked {
    background-color: #0F1115;
    border: 1px solid #3A4250;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #5B9DF5;
}

QCheckBox::indicator:checked {
    background-color: #5B9DF5;
    border: 1px solid #5B9DF5;
}

QCheckBox::indicator:checked:hover {
    background-color: #7AB3FF;
    border-color: #7AB3FF;
}

QCheckBox::indicator:disabled {
    background-color: #161A20;
    border: 1px solid #22272F;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    background: #343C48;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #5B9DF5;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #E6E8EB;
    border: 2px solid #5B9DF5;
    width: 10px;
    height: 10px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #7AB3FF;
}

QSlider::handle:horizontal:pressed {
    background: #5B9DF5;
    border-color: #4A88D9;
}

QSlider::sub-page:horizontal:disabled {
    background: #3A4250;
}

QSlider::handle:horizontal:disabled {
    background: #5A6270;
    border-color: #3A4250;
}

/* ── Menus and item views (menus, Add-step list) ── */
QMenu, #addMenu {
    background-color: #1C2129;
    border: 1px solid #2A3039;
    padding: 4px;
    color: #E6E8EB;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #274467;
}

QMenu::item:disabled {
    color: #5A6270;
}

QMenu::separator {
    height: 1px;
    background: #2A3039;
    margin: 4px 6px;
}

QListView, QTreeView {
    background-color: transparent;
    border: none;
    outline: none;
    color: #E6E8EB;
    selection-background-color: #274467;
    selection-color: #E6E8EB;
}

QListView::item, QTreeView::item {
    padding: 5px 8px;
    border-radius: 4px;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: #222833;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #274467;
    color: #E6E8EB;
}

/* Category header rows in the Add-step list are disabled items */
QListView::item:disabled, QTreeView::item:disabled {
    background-color: transparent;
    color: #8B93A1;
}

/* ── Scroll bars ── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #343C48;
    min-height: 30px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #343C48;
    min-width: 30px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #4A5361;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #5B9DF5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* ── Progress bar (thin busy indicator) ── */
QProgressBar {
    background-color: transparent;
    border: none;
    min-height: 2px;
    max-height: 2px;
}

QProgressBar::chunk {
    background-color: #5B9DF5;
    border-radius: 1px;
}

/* Keyboard focus on a card (Delete removes it) */
#stepCard:focus {
    border: 1px solid #5B9DF5;
}
